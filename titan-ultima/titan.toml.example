# titan.toml.example — copy this file to titan.toml and edit paths.
#
# Auto-detected locations (in order):
#   ./titan.toml                      (current working directory)
#   ~/.config/titan/config.toml       (Linux / macOS)
#   %APPDATA%\titan\config.toml       (Windows)
#
# Run `titan setup` to generate this file interactively.
#
# ─── FORMAT ──────────────────────────────────────────────────────
# Legacy flat format ([game] + [paths]) is still supported and is
# treated as an Ultima 8 configuration.  The new multi-game format
# uses [u8.game] / [u8.paths], [u7bg.game] / [u7bg.paths], etc.
# Both formats are shown below.


# ═══════════════════════════════════════════════════════════════════
# LEGACY FORMAT (Ultima 8 only) — still fully supported
# ═══════════════════════════════════════════════════════════════════

[game]
# GOG Galaxy (Windows):    C:/Program Files (x86)/GOG Galaxy/Games/Ultima 8
# GOG Offline (Windows):   C:/GOG Games/Ultima 8
# GOG (Linux):             ~/GOG Games/Ultima 8
# Legacy EA/Origin:        C:/Program Files/EA Games/Ultima 8 Gold Edition
base     = "C:/Program Files (x86)/GOG Galaxy/Games/Ultima 8"  # ← change to match your install
language = "ENGLISH"     # ← FRENCH, GERMAN, etc.  |  leave empty ("") for flat mode

# Flat mode (language = ""):
#   All STATIC files are expected directly inside base/.
#   Useful when you copy the files to your working directory.

[paths]
# These names are relative → auto-expanded to <base>/<language>/STATIC/<name>
fixed     = "FIXED.DAT"
palette   = "U8PAL.PAL"
typeflag  = "TYPEFLAG.DAT"
gumpage   = "GUMPAGE.DAT"
xformpal  = "XFORMPAL.DAT"
ecredits  = "ECREDITS.DAT"
quotes    = "QUOTES.DAT"

u8shapes  = "U8SHAPES.FLX"
u8fonts   = "U8FONTS.FLX"
u8gumps   = "U8GUMPS.FLX"

# Pre-extracted directories — relative to wherever you run titan.
# Run `titan flex-extract U8SHAPES.FLX -o shapes/` and
#      `titan flex-extract GLOB.FLX     -o globs/`  once to populate them.
shapes    = "shapes/"
globs     = "globs/"

# Live / dynamic objects — from a game save or Pentagram/ScummVM.
# Relative names are expanded to <base>/cloud_saves/SAVEGAME/<name>  (GOG layout).
# Absolute paths (e.g. from Pentagram) are used as-is.
nonfixed  = "U8SAVE.000"

# Pentagram / ScummVM examples (absolute path, unchanged):
# nonfixed = "C:/Users/<you>/AppData/Roaming/Pentagram/u8-save/U8SAVE.000"  # Windows
# nonfixed = "~/Library/Application Support/Pentagram/u8-save/U8SAVE.000"   # macOS


# ═══════════════════════════════════════════════════════════════════
# NEW MULTI-GAME FORMAT (uncomment to use)
# ═══════════════════════════════════════════════════════════════════
#
# When the [u8] section is present it takes precedence; the legacy
# [game]/[paths] sections above serve as fallback for backward compat.
#
# [u8.game]
# base     = "C:/Program Files (x86)/GOG Galaxy/Games/Ultima 8"
# language = "ENGLISH"
#
# [u8.paths]
# fixed    = "FIXED.DAT"
# palette  = "U8PAL.PAL"
# typeflag = "TYPEFLAG.DAT"
# shapes   = "shapes/"
# globs    = "globs/"
# nonfixed = "U8SAVE.000"
#
# [uw2.game]
# # Commands resolve bare data names below <base>/DATA.
# base = "C:/Path/To/Ultima Underworld 2"
#
# [u9.game]
# # Detected by `titan setup`; save-browse uses this when no source is supplied.
# base = "C:/Program Files (x86)/GOG Galaxy/Games/Ultima 9"
#
# [u9.paths]
# # Relative paths resolve from [u9.game].base; actual filename case is retained.
# static   = "static"
# runtime  = "runtime"
# sound    = "sound"
# savegame = "savegame"
# palette  = "static/ankh.pal"
# bitmap16 = "static/bitmap16.flx"
# bitmapc  = "static/bitmapC.flx"
# bitmapsh = "static/bitmapsh.flx"
# sdinfo16 = "static/sdInfo16.flx"
# sdinfoc  = "static/sdInfoC.flx"
# sdinfo   = "static/sdInfo.flx"
# # Optional default texture tier. Omit to use bitmap16.
# textures = "static/bitmap16.flx"
# # Setup adds these and other supported assets when present. Without explicit
# # overrides, commands look for their usual filenames in the folders above.
# sappear    = "static/sappear.flx"
# types      = "static/TYPES.DAT"
# typenames  = "static/TYPENAME.FLX"
# animations = "static/anim.flx"
# registry   = "static/registry.txt"
# triggers   = "static/triggers.flx"
# activities = "static/activity.flx"
# text       = "static/text.flx"
# text_keys  = "static/text.dat"
# books      = "static/BOOKS-EN.FLX"
# npcs       = "runtime/NPC.FLX"
# processes  = "savegame/processes.dat"
# categories = "sound/sfxcat.flx"
# templates  = "sound/SFXTMPL.FLX"
# # This reference is deliberately user-selected; setup never assigns the
# # installed maps as their own trusted creation-time reference.
# fixed_reference = "C:/Trusted/U9/static"
#
# [u7bg.game]
# base     = "C:/Path/To/Ultima7/ULTIMA7"
# variant  = "blackgate"
#
# [u7bg.paths]
# # Install-side original/static data. Relative paths expand from [u7bg.game].base.
# static   = "STATIC/"
# shapes   = "STATIC/SHAPES.VGA"
# palette  = "STATIC/PALETTES.FLX"
# # Live Exult runtime data. Prefer the AppData copy when it has npc.dat;
# # fall back to install-side gamedat/ only when no AppData runtime exists.
# gamedat  = "C:/Users/<you>/AppData/Local/Exult/blackgate/gamedat"
#
# [u7si.game]
# base     = "C:/Path/To/Ultima7/SERPENT"
# variant  = "serpentisle"
#
# [u7si.paths]
# # Install-side original/static data. Relative paths expand from [u7si.game].base.
# static   = "STATIC/"
# shapes   = "STATIC/SHAPES.VGA"
# palette  = "STATIC/PALETTES.FLX"
# # Base-game live runtime data. This may be empty until SI has been initialized.
# gamedat  = "C:/Users/<you>/AppData/Local/Exult/serpentisle/gamedat"
#
# [u7si.mods."<mod-name>".paths]
# # Mod profile root, if Exult has initialized that mod.
# root     = "C:/Users/<you>/AppData/Local/Exult/serpentisle/mods/<mod-name>"
# # Folder containing the most .sav files found under the mod profile root.
# saves    = "C:/Users/<you>/AppData/Local/Exult/serpentisle/mods/<mod-name>/saves"
# # Mod live runtime data, if Exult has initialized that mod.
# gamedat  = "C:/Users/<you>/AppData/Local/Exult/serpentisle/mods/<mod-name>/gamedat"
# # Mod packaged initial runtime data. Exult mods often store this as a
# # ZIP-style initgame.dat containing npc.dat, schedule.dat, u7iregNN, etc.
# archive  = "C:/Path/To/Ultima7/SERPENT/mods/<mod-name>/patch/initgame.dat"
#
# [uo.game]
# # Single install: the client directory used when CLIENT is omitted.
# base     = "C:/Program Files (x86)/Electronic Arts/Ultima Online Classic"
# # Several installs: name the default [uo.installs.*] entry instead.
# install  = "classic"
#
# # Named installs. A uo command's CLIENT argument may be one of these names
# # (e.g. `titan uo map-export uof`) or a directory. Each install can set its
# # own default output root and source preferences.
# [uo.installs.classic]
# label    = "EA Ultima Online Classic Client"
# path     = "C:/Ultima/UltimaOnlineClassicClient"
# output   = "D:/data/uodata/classic"
#
# [uo.installs.uof]
# label    = "UO Forever freeshard client"
# path     = "G:/Games/UOForever/UO"
# output   = "D:/data/uodata/uof"
# multis   = "mul"     # multi source: auto | uop | mul
# server_profile = "D:/data/uodata/server-profiles/servuo.json"  # per-install override
# maps     = "auto"    # terrain source: auto | uop | mul
#
# [uo.reference]
# # Server profile for `titan uo house-footprints` / `house-capacity`: regions,
# # region rules and the house menu in one JSON file. Without one, Titan uses
# # its built-in house list and cannot exclude towns or dungeons.
# server_profile = "D:/data/uodata/server-profiles/servuo.json"
# # Alternatively, point at an emulator's files directly:
# # house_placement_tool = "C:/src/servuo/Scripts/Multis/HousePlacementTool.cs"
# # regions_xml          = "C:/src/servuo/Data/Regions.xml"
# # emulator_scripts     = "C:/src/servuo/Scripts"
